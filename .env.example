# Trae Enterprise OpenAPI credentials
# Get these from: https://console.enterprise.trae.cn
TRAE_APP_ID=your_app_id_here
TRAE_APP_SECRET=your_app_secret_here

# Set to 1 to use mock data (no real API calls)
TRAE_DASHBOARD_MOCK=1

# SMTP authorization code for daily email report
# (QQ Mail: 设置 → 账户 → 开启 POP3/SMTP → 生成授权码)
# Only required when email.enabled: true in config.yaml
SMTP_PASSWORD=your_smtp_auth_code_here
# The dashboard's "邮件设置" tab can write SMTP_PASSWORD here.
# Manual edits are fine; the dashboard will overwrite the SMTP_PASSWORD line.
